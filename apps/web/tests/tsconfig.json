{
  // The test suite runs outside the Nuxt runtime: plain modules, Vitest globals
  // and Node types. Keeping it in its own project means `nuxt typecheck` does
  // not have to know about Vitest, and the tests still get full type coverage
  // via `vue-tsc -p tests`.
  "extends": "../.nuxt/tsconfig.shared.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "noEmit": true,
    "strict": true
  },
  "include": ["./**/*.ts", "../app/**/*.ts"],
  "exclude": ["../node_modules", "../.nuxt", "../.output"]
}
