# =============================================================================
# MurasFood — example environment file
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
# =============================================================================

# --- Django ----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_TIME_ZONE=America/Sao_Paulo

# --- Database ---------------------------------------------------------------
# When unset, the test settings fall back to SQLite so the suite runs anywhere.
DATABASE_URL=postgres://murasfood:murasfood@postgres:5432/murasfood
POSTGRES_DB=murasfood
POSTGRES_USER=murasfood
POSTGRES_PASSWORD=murasfood

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# --- Authentication ---------------------------------------------------------
# Access tokens are short lived; refresh tokens rotate and are blacklisted.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# --- CORS / CSRF ------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Object storage (S3 compatible: MinIO, Cloudflare R2, AWS S3) ----------
# Leave S3_ENDPOINT empty to store media on the local filesystem (dev only).
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=murasfood
S3_SECRET_KEY=murasfood-secret
S3_BUCKET=murasfood-media
S3_REGION=us-east-1
S3_SIGNED_URL_TTL_SECONDS=900

# --- SMTP -------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=no-reply@example.test
SMTP_FROM_NAME=MurasFood

# --- Payments ---------------------------------------------------------------
# `sandbox` is a deterministic in-process PIX provider used for development
# and automated tests. Never use it in production.
PAYMENT_PROVIDER=sandbox
PAYMENT_API_KEY=
PAYMENT_API_BASE_URL=
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_PIX_EXPIRATION_SECONDS=1800

# --- Public URLs ------------------------------------------------------------
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# --- Frontend (Nuxt) --------------------------------------------------------
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NUXT_PUBLIC_DEFAULT_TENANT=demo
NUXT_PUBLIC_DEFAULT_LOCALE=pt-BR

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
